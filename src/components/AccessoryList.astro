---
import type { ChargerModel } from "../data/models";
import { accessoriesFor, KIND_LABEL } from "../data/accessories";
import { AFFILIATE_REL, amazonLink } from "../lib/amazon";

interface Props {
  model: ChargerModel;
}
const { model: m } = Astro.props;
const items = accessoriesFor(m.id).slice(0, 4);
---

{items.length > 0 && (
  <section class="acc" aria-labelledby="accessories">
    <h2 id="accessories">Accessories for the {m.shortName}</h2>
    <p class="acc-intro">
      Useful add-ons for your install, sold on Amazon. {m.install.includes("14-50") ? "Since this charger can plug in, the outlet quality matters — go industrial grade." : "An adapter in the frunk covers you for mixed-connector situations."}
    </p>
    <ul class="acc-list">
      {items.map((a) => (
        <li class="acc-row">
          <span class="acc-kind">{KIND_LABEL[a.kind]}</span>
          <div class="acc-main">
            <strong>{a.name}</strong>
            <span class="acc-tag">{a.oem ? `Official ${a.brand}` : "Universal fit"}</span>
            <p>{a.why}{a.fitNote ? ` ${a.fitNote}` : ""}</p>
          </div>
          <div class="acc-buy">
            <a class="btn buy btn-xs" href={amazonLink(a.name, a.asin)} rel={AFFILIATE_REL} target="_blank">Check price</a>
          </div>
        </li>
      ))}
    </ul>
    <p class="fine">Compatibility checked October 2026. More in our <a href="/accessories/">accessories guide</a>.</p>
  </section>
)}
