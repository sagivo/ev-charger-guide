---
// Stylized wallbox EV charger illustration used whenever no licensed product
// photo exists in src/assets/chargers/.
import type { ChargerModel } from "../data/models";

interface Props {
  model: ChargerModel;
  size?: number;
}
const { model: m, size = 96 } = Astro.props;
// Subtle per-tier tint for the status LED.
const led = m.tier === "premium" ? "#c8f03c" : m.tier === "mid" ? "#3aa5f0" : "#9fd6f5";
---

<svg class="charger-art" width={size} height={Math.round(size * 0.78)} viewBox="0 0 170 132" role="img" aria-label={`Illustration of the ${m.name}`}>
  <defs>
    <linearGradient id="cbody" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff"/>
      <stop offset="1" stop-color="#dbe6ef"/>
    </linearGradient>
    <linearGradient id="ccable" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#22303f"/>
      <stop offset="1" stop-color="#0a1622"/>
    </linearGradient>
  </defs>
  <!-- wall plate -->
  <rect x="52" y="10" width="66" height="8" rx="4" fill="#b8c7d4"/>
  <!-- charger body -->
  <rect x="56" y="18" width="58" height="76" rx="14" fill="url(#cbody)" stroke="#0a1622" stroke-width="3"/>
  <!-- screen -->
  <rect x="68" y="30" width="34" height="22" rx="5" fill="#0e2a46"/>
  <path d="M86 34 74 46h7l-2 10 12-13h-7l3-9z" fill={led}/>
  <!-- LED status dot -->
  <circle cx="85" cy="64" r="4.5" fill={led}/>
  <rect x="70" y="74" width="30" height="4" rx="2" fill="#b8c7d4"/>
  <!-- holster -->
  <rect x="114" y="44" width="14" height="34" rx="6" fill="#22303f"/>
  <!-- cable -->
  <path d="M128 78 C 150 84, 150 108, 118 110 C 96 111, 92 96, 104 92" fill="none" stroke="url(#ccable)" stroke-width="7" stroke-linecap="round"/>
  <!-- plug handle -->
  <rect x="96" y="82" width="14" height="24" rx="6" fill="#0a1622" transform="rotate(18 103 94)"/>
  <rect x="99" y="76" width="8" height="10" rx="3" fill="#3aa5f0" transform="rotate(18 103 81)"/>
  <!-- ground shadow -->
  <ellipse cx="85" cy="124" rx="46" ry="6" fill="#0a1622" opacity="0.12"/>
</svg>
