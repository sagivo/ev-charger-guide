---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import PostCard from "../components/PostCard.astro";
import ComparisonTable from "../components/ComparisonTable.astro";
import ProductImage from "../components/ProductImage.astro";
import BuyButton from "../components/BuyButton.astro";
import StickyCta from "../components/StickyCta.astro";
import PriceTier from "../components/PriceTier.astro";
import { SITE_NAME, SITE_DESCRIPTION } from "../lib/site";
import { MODELS, getModel, priceTier, CONNECTOR_LABEL } from "../data/models";
import { getPosts } from "../lib/posts";
import { websiteLd, faqLd, itemListLd } from "../lib/schema";
import { HOME_PICKS } from "../data/picks";

const posts = await getPosts();
const latest = [...posts].sort(
  (a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf()
);
const guides = latest.filter((p) => p.data.category !== "best").slice(0, 6);
const topModels = [...MODELS].sort((a, b) => b.score - a.score).slice(0, 6);
const picks = HOME_PICKS.map((p) => ({ ...p, model: getModel(p.id) }));

const top = picks[0].model;
// Award colours for the four homepage picks.
const ACCENTS = ["#c8f03c", "#3aa5f0", "#7fd8c6", "#ffd34f"];

// Each tile shows the #1 pick from its guide, so readers can buy straight from the homepage.
const chargerTypes = [
  { slug: "nacs-vs-j1772-explained", icon: "🔌", title: "NACS vs J1772", text: "The 2026 connector transition, explained — and which to buy." },
  { slug: "hardwired-vs-plug-in-ev-charger", icon: "🧰", title: "Hardwired vs plug-in", text: "Which install type fits your home, panel, and plans." },
  { slug: "level-2-ev-charger-installation-cost-rebates", icon: "💵", title: "Install cost & rebates", text: "What the electrician costs, plus the 30% tax credit." },
  { slug: "how-to-choose-a-level-2-ev-charger", icon: "📐", title: "How to choose", text: "Amperage, panel capacity, and smart features — without overbuying." },
  { slug: "tesla-wall-connector-vs-chargepoint-home-flex-vs-grizzl-e", icon: "⚔️", title: "Tesla vs ChargePoint vs Grizzl-E", text: "The three big names, head to head." },
  { slug: "best-level-2-ev-chargers-2026", icon: "🏆", title: "The 2026 ranking", text: "All 11 chargers ranked, with the reasoning shown." },
].map((y) => {
  const first = posts.find((p) => p.id === y.slug)?.data.picks?.[0];
  return { ...y, href: `/posts/${y.slug}/`, pick: first ? getModel(first.id) : undefined };
});

const faq = [
  {
    q: "What is the best Level 2 EV charger in 2026?",
    a: `Our top-rated pick overall is the ${picks[0].model.name}: 48 A / 11.5 kW with the only integrated NACS + J1772 connector, so it charges any EV. Tesla-only households can save with the standard Wall Connector; value buyers should look at the EVIQO Gen 2.`,
  },
  {
    q: "How many amps do I need for home EV charging?",
    a: "40–48 amps covers virtually everyone. 40 A adds ~30 miles of range per hour; 48 A adds ~35–44. Overnight, even 32 A refills most daily driving. A 48-amp charger needs a dedicated 60-amp breaker.",
  },
  {
    q: "Should I buy a NACS or J1772 charger?",
    a: "NACS for Teslas and 2025+ EVs (native NACS ports); J1772 still works natively for older non-Tesla EVs. Dual-connector chargers like the Tesla Universal Wall Connector sidestep the choice entirely.",
  },
  {
    q: "How much does Level 2 charger installation cost?",
    a: "The charger runs ~$350–$600; a straightforward electrician install adds $300–$800. Long wire runs or panel upgrades push the total to $1,200–$2,500+. The 30% federal tax credit (up to $1,000) covers charger plus install.",
  },
];

const jsonLd = [websiteLd(), itemListLd("Top Level 2 EV home chargers of 2026", picks.map((p) => p.model)), faqLd(faq)];
---

<BaseLayout
  title={`${SITE_NAME}: Best Level 2 EV Home Chargers of 2026, Compared`}
  description={SITE_DESCRIPTION}
  jsonLd={jsonLd}
  hidePromo
>
  <section class="hero">
    <div class="wrap wide hero-grid">
      <div>
        <span class="hero-kicker"><span class="dot" aria-hidden="true"></span>Updated October 2026</span>
        <h1>The best Level 2 EV chargers of 2026, <em>ranked.</em></h1>
        <p class="lead">
          We compared {MODELS.length} home chargers on power, connector, install
          flexibility, smarts and price — including the 2026 NACS transition —
          so you can skip the research and start charging faster.
        </p>
        <div class="cta-row">
          <a class="btn btn-lg" href="/posts/best-level-2-ev-chargers-2026/">See the ranking</a>
          <a class="btn secondary btn-lg" href="#match">Match my garage</a>
        </div>
        <div class="hero-proof">
          <div><strong>{MODELS.length}</strong><span>chargers compared</span></div>
          <div><strong>{new Set(MODELS.map((m) => m.brand)).size}</strong><span>brands compared</span></div>
          <div><strong>48 A</strong><span>our recommended sweet spot</span></div>
        </div>
      </div>

      <aside class="spotlight" aria-label="Our top pick">
        <div class="sp-ribbon"><span>⚡ #1 {picks[0].label}</span><span>2026</span></div>
        <div class="sp-media"><ProductImage model={top} size={260} eager /></div>
        <div class="sp-body">
          <h2 class="sp-name"><a href={`/chargers/${top.id}/`}>{top.name}</a></h2>
          <div class="sp-meta">
            <span class="ring" style={`--v:${top.score * 10}`}><span>{top.score.toFixed(1)}</span></span>
            <span class="ring-label"><strong>Guide score</strong>out of 10</span>
            <span class="sp-price"><PriceTier model={top} label={false} /><small>{priceTier(top).label} price tier</small></span>
          </div>
          <ul class="sp-points">{top.pros.slice(0, 3).map((p) => <li>{p}</li>)}</ul>
          <BuyButton model={top} size="lg" block />
          <div class="sp-links">
            <a href={`/chargers/${top.id}/`}>Read the review →</a>
            <a href="/chargers/">Compare all {MODELS.length}</a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="trust-bar" aria-label="Why readers trust us">
    <ul>
      <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/><path d="M8.5 12l2.5 2.5 4.5-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>Commissions never decide rankings</li>
      <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>Specs cross-checked across sources</li>
      <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M12 7.5V12l3 2" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>Specs refreshed October 2026</li>
      <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19V9M12 19V5M19 19v-7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>Free charge-time &amp; cost calculators</li>
    </ul>
  </section>

  <div class="wrap wide">
    <div class="section-head">
      <div>
        <span class="eyebrow">Editor's picks</span>
        <h2 class="section-title">The 4 EV chargers we'd buy in 2026</h2>
        <p class="section-sub">One clear winner for each kind of buyer. Tap a card for the full review.</p>
      </div>
      <a class="section-link" href="/posts/best-level-2-ev-chargers-2026/">Full ranking →</a>
    </div>
    <div class="tp-grid four">
      {picks.map((p, i) => <ProductCard model={p.model} label={p.label} featured={i === 0} accent={ACCENTS[i]} />)}
    </div>
    <p class="swipe-hint">Swipe for more picks →</p>

    <form class="matcher" id="match" action="/tools/charge-time-calculator/" method="get">
      <div>
        <span class="eyebrow" style="color:var(--ink)">30-second matcher</span>
        <h2>How fast could you charge at home?</h2>
        <p>Tell us your battery size and we'll show charge times, miles per hour, and the chargers that deliver.</p>
      </div>
      <div class="mq">
        <fieldset>
          <legend>Your EV's battery size?</legend>
          <div class="mq-opts">
            <label><input type="radio" name="batt" value="55" /><span>~55 kWh</span></label>
            <label><input type="radio" name="batt" value="75" checked /><span>~75 kWh</span></label>
            <label><input type="radio" name="batt" value="100" /><span>~100 kWh</span></label>
          </div>
        </fieldset>
        <button class="btn dark btn-lg" type="submit">Calculate charge time →</button>
      </div>
    </form>

    <div class="section-head">
      <div>
        <span class="eyebrow">Start here</span>
        <h2 class="section-title">EV charging, explained</h2>
      </div>
      <a class="section-link" href="/guides/">All guides →</a>
    </div>
    <div class="yard-grid">
      {chargerTypes.map((y) => (
        <div class="yard">
          <div class="yard-top">
            <div class="yard-icon" aria-hidden="true">{y.icon}</div>
            <h3><a href={y.href}>{y.title}</a></h3>
          </div>
          <p>{y.text}</p>
          {y.pick && (
            <div class="yard-pick">
              <span><small>Top pick</small><strong>{y.pick.shortName}</strong></span>
              <BuyButton model={y.pick} label="Check price" size="sm" />
            </div>
          )}
          <span class="go">Read the guide</span>
        </div>
      ))}
    </div>

    <div class="section-head">
      <div>
        <span class="eyebrow">Side by side</span>
        <h2 class="section-title">Highest-rated chargers at a glance</h2>
      </div>
      <a class="section-link" href="/chargers/">Compare all {MODELS.length} →</a>
    </div>
    <ComparisonTable models={topModels} />

    <div class="section-head">
      <div>
        <span class="eyebrow">Free tools</span>
        <h2 class="section-title">Don't guess. Calculate.</h2>
      </div>
      <a class="section-link" href="/tools/">All tools →</a>
    </div>
    <div class="tool-grid">
      <a class="tool-card" href="/tools/charge-time-calculator/">
        <div class="tool-icon">⚡</div>
        <h3>Charge Time Calculator</h3>
        <p>Enter your battery size and charger power to get charge times and matching chargers.</p>
        <span class="go">Calculate</span>
      </a>
      <a class="tool-card" href="/tools/panel-capacity-checker/">
        <div class="tool-icon">🔌</div>
        <h3>Panel Capacity Checker</h3>
        <p>See if your electrical panel can handle a 40 A or 48 A charger.</p>
        <span class="go">Check my panel</span>
      </a>
      <a class="tool-card" href="/tools/ev-vs-gas-cost/">
        <div class="tool-icon">💰</div>
        <h3>EV vs Gas Cost</h3>
        <p>Compare a year of gasoline against a year of home charging at your rates.</p>
        <span class="go">Do the math</span>
      </a>
    </div>

    <div class="section-head">
      <div>
        <span class="eyebrow">Buying advice</span>
        <h2 class="section-title">Comparisons &amp; guides</h2>
      </div>
      <a class="section-link" href="/guides/">All guides →</a>
    </div>
    <div class="post-grid">
      {guides.map((post) => <PostCard post={post} />)}
    </div>

    <section class="strip" aria-label="Why trust this guide">
      <div>
        <h2>Research you can actually check.</h2>
        <p>We earn a commission when you buy through our links, but it never changes which charger we recommend.</p>
        <a class="btn" href="/how-we-research/">How we score chargers</a>
      </div>
      <div class="strip-items">
        <div><div class="n">01</div><h3>NACS transition covered</h3><p>Every charger rated on connector future-proofing for the 2026 NACS switchover.</p></div>
        <div><div class="n">02</div><h3>Specs, cross-checked</h3><p>Amperage, cable length and connector options verified across manufacturers, reviews and owner reports.</p></div>
        <div><div class="n">03</div><h3>Tools, not just words</h3><p>Calculators built from real specs turn "which charger?" into a number, not a guess.</p></div>
      </div>
    </section>

    <section class="faq home-faq" aria-label="Frequently asked questions">
      <h2 class="section-title">EV charger FAQ</h2>
      {faq.map((f) => <details><summary>{f.q}</summary><div>{f.a}</div></details>)}
    </section>
  </div>

  <StickyCta model={top} label={`#1 ${picks[0].label}`} showAfter={1400} />
</BaseLayout>
